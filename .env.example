# Por padrão o Meu Dia usa SQLite (arquivo meudia.db), sem instalar nada.
# Só crie um arquivo .env se quiser usar MySQL.

APP_NAME=Meu Dia

# DB_ENGINE=sqlite   -> padrão, zero configuração
# DB_ENGINE=mysql    -> usa os dados abaixo
DB_ENGINE=sqlite

DB_HOST=localhost
DB_PORT=3306
DB_NAME=agenda
DB_USER=root
DB_PASSWORD=
